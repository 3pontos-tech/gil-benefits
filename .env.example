APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dev_flamma
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
MEDIA_DISK=r2
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=

FLAMMA_STRIPE_ENTERPRISE_PRODUCT_ID=
FLAMMA_STRIPE_ENTERPRISE_PRICE_ID=

FLAMMA_STRIPE_USER_GOLD_PRODUCT_ID=
FLAMMA_STRIPE_USER_GOLD_PRICE_ID=

FLAMMA_STRIPE_USER_PLATINUM_PRODUCT_ID=
FLAMMA_STRIPE_USER_PLATINUM_PRICE_ID=

FLAMMA_STRIPE_USER_BLACK_PRODUCT_ID=
FLAMMA_STRIPE_USER_BLACK_PRICE_ID=

FLAMMA_STRIPE_ENTERPRISE_PORTAL_ID=
FLAMMA_STRIPE_USER_PORTAL_ID=

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=
GOOGLE_CALENDAR_SYNC_DAYS_AHEAD=
GOOGLE_CALENDAR_CONNECTION_RETRY_TIMES=
GOOGLE_CALENDAR_CONNECTION_RETRY_DELAY_MS=

CLOUDFLARE_R2_ENDPOINT=http://localhost:9000
CLOUDFLARE_R2_BUCKET=flamma-minio
CLOUDFLARE_R2_URL="http://localhost:9000/${CLOUDFLARE_R2_BUCKET}"
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=true
CLOUDFLARE_R2_ACCESS_KEY_ID=minioadmin
CLOUDFLARE_R2_SECRET_ACCESS_KEY=minioadmin

BARTE_API_KEY=
BARTE_BASE_URL=https://sandbox-api.barte.com
BARTE_WEBHOOK_SECRET=

# --- integration-virtu ---
# Gateway Pagaa/Virtu. A chave privada (sk_live_...) e o company id vão nos
# headers x-api-key e x-company-id de toda requisição.
VIRTU_API_KEY=
VIRTU_COMPANY_ID=
VIRTU_BASE_URL=https://sandbox-virtu-api.pagaa.com.br/api/v1/public
# Hex de 64 chars, exibido uma única vez ao cadastrar o webhook no painel.
# Assina o corpo cru da requisição em HMAC-SHA256 (header X-Webhook-Signature).
VIRTU_WEBHOOK_SECRET=

# --- integration-monday ---
# Token da API da Monday e segredo do webhook (?token= na URL registrada na Monday).
MONDAY_API_TOKEN=
MONDAY_WEBHOOK_SECRET=
# Sem MONDAY_BOARD_ID o canal de TI continua indo por e-mail (integração desligada).
MONDAY_BOARD_ID=
MONDAY_GROUP_ID=topics
# IDs técnicos das colunas do board (não os títulos).
MONDAY_COLUMN_STATUS=
MONDAY_COLUMN_PROTOCOL=
MONDAY_COLUMN_CATEGORY=
MONDAY_COLUMN_REQUESTER=
MONDAY_COLUMN_DESCRIPTION=
MONDAY_COLUMN_ATTACHMENTS=
MONDAY_COLUMN_CREATED_AT=
MONDAY_COLUMN_UPDATED_AT=
# ÍNDICE de cada label na coluna de status do board (estável a renomeação/idioma).
MONDAY_STATUS_INDEX_PENDING=17
MONDAY_STATUS_INDEX_IN_PROGRESS=0
MONDAY_STATUS_INDEX_RESOLVED=2
MONDAY_STATUS_INDEX_CLOSED=3

LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

GEMINI_API_KEY=

APPOINTMENTS_AI_PRIMARY_PROVIDER=gemini
APPOINTMENTS_AI_PRIMARY_MODEL=gemini-3.1-flash-lite-preview
APPOINTMENTS_AI_FALLBACK_PROVIDER=gemini
APPOINTMENTS_AI_FALLBACK_MODEL=gemini-3-flash-preview

# Destinatários (separados por vírgula) das notificações de novas solicitações de agendamento.
# Vazio por padrão para não enviar e-mails em dev/teste.
APPOINTMENTS_ADMIN_NOTIFICATION_RECIPIENTS=

# --- billing / financeiro ---
# Valor de UMA consultoria que consumiu crédito, em CENTAVOS (reais × 100), usado no
# relatório financeiro / cockpit (STORY-239). Ausente ou comentado = "não configurado":
# a tela avisa em vez de exibir zero. Deixar VAZIO (=) grava zero, não "não configurado".
# Só o valor vigente é usado, e alterá-lo recalcula os meses passados. Ex.: R$ 120,00 → 12000
# FLAMMA_CONSULTING_VALUE_IN_CENTS=12000

# Preço de um crédito avulso, em centavos. Padrão: 15000 (R$ 150,00)
# CREDIT_PRICE_IN_CENTS=15000
